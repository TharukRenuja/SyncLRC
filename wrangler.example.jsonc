{
  "name": "synclrc",
  "main": "src/index.js",
  "compatibility_date": "2025-02-01",
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "UPSTREAM_URL": "https://your-upstream.api",
    "UPSTREAM_SECRET": "your-upstream-secret"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "synclrc-d1",
      "database_id": "your-d1-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "synclrc-r2"
    }
  ]
}
