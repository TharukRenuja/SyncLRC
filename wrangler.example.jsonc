{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "synclrc",
  "main": "src/index.js",
  "compatibility_date": "2025-02-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "UPSTREAM_URL": "https://your-upstream.api",
    "UPSTREAM_SECRET": "your-upstream-secret",
    // Days a stored lyric is retained before the daily purge deletes it. Lyrics are
    // held transiently and refetched on demand, so this only trades storage against
    // repeat upstream lookups. Defaults to 1 when unset.
    "RETENTION_DAYS": "1"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "synclrc-db",
      "database_id": "your-d1-id"
    }
  ]
}
