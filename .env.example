# ──────────────────────────────────────────────
# Local development secrets for SyncLRC Worker
# COPY THIS FILE TO .dev.vars (not .env)
# ──────────────────────────────────────────────

# URL of the upstream karaoke scraper service.
# Required for `type=karaoke` — the Worker proxies this endpoint.
# Can be self-hosted (e.g. FastAPI on Render/Vercel/fly.io) or the public instance.
# Example: "https://resynclrc.vercel.app"
UPSTREAM_URL="https://your-upstream.example.com"

# Shared secret used to authenticate the upstream request.
# Sent as the `X-SyncLRC-Secret` header. Must match the scraper's expected secret.
# Generate one with:  openssl rand -hex 32
UPSTREAM_SECRET="your-64-char-hex-secret"
