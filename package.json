{
  "name": "synclrc",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create synclrc-db",
    "d1:apply": "wrangler d1 execute synclrc-db --file=src/schema.sql",
    "d1:migrate": "wrangler d1 execute synclrc-db --remote --file=migrations/migration.sql"
  }
}
